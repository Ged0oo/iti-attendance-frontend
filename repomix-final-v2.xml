              />
            </div>
            <div class="grid grid-cols-2 gap-6 max-w-md">
              <div class="flex flex-col gap-2">
                <label class="font-label text-label text-on-surface-variant">Start Date</label>
                <input
                  v-model="basicForm.start_date"
