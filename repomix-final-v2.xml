axios.interceptors.request.use((config) => {
    if (config.url && config.url.includes('/api/api/')) {
        config.url = config.url.replace('/api/api/', '/api/');
    }
    return config;
});
const app = createApp(App)
app.use(createPinia())
app.use(router)
app.mount('#app')
